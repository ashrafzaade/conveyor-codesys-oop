                  <ObjectId>d9154b34-f8d8-467a-96db-1436d19b1c69</ObjectId>
                </data>
              </addData>
            </pou>
          </data>
          <data name="http://www.3s-software.com/plcopenxml/pou" handleUnknown="implementation">
            <pou name="FB_Conveyor" pouType="functionBlock">
              <interface>
                <inputVars>
                  <variable name="bSensor">
                    <type>
                      <BOOL />
                    </type>
                    <documentation>
                      <xhtml xmlns="http://www.w3.org/1999/xhtml"> Product detection sensor</xhtml>
                    </documentation>
                  </variable>
                  <variable name="bEStopNC">
                    <type>
                      <BOOL />
                    </type>
                    <initialValue>
                      <simpleValue value="TRUE" />
                    </initialValue>
                    <documentation>
                      <xhtml xmlns="http://www.w3.org/1999/xhtml"> Emergency stop (NC: TRUE in normal condition)</xhtml>
                    </documentation>
                  </variable>
                  <variable name="iTarget">
                    <type>
                      <INT />
                    </type>
                    <initialValue>
                      <simpleValue value="10" />
                    </initialValue>
                    <documentation>
                      <xhtml xmlns="http://www.w3.org/1999/xhtml"> Target count per batch</xhtml>
                    </documentation>
                  </variable>
                </inputVars>
                <outputVars>
                  <variable name="bMotor">
                    <type>
                      <BOOL />
                    </type>
                    <documentation>
                      <xhtml xmlns="http://www.w3.org/1999/xhtml"> Conveyor motor</xhtml>
                    </documentation>
                  </variable>
                  <variable name="bBatchDone">
                    <type>
                      <BOOL />
                    </type>
                    <documentation>
                      <xhtml xmlns="http://www.w3.org/1999/xhtml"> TRUE when the batch is complete</xhtml>
                    </documentation>
                  </variable>
                  <variable name="bEStopActive">
                    <type>
                      <BOOL />
                    </type>
                    <documentation>
                      <xhtml xmlns="http://www.w3.org/1999/xhtml"> TRUE while in emergency stop state</xhtml>
                    </documentation>
                  </variable>
                  <variable name="iCount">
                    <type>
                      <INT />
                    </type>
                    <documentation>
                      <xhtml xmlns="http://www.w3.org/1999/xhtml"> Product counter</xhtml>
                    </documentation>
                  </variable>
                </outputVars>
                <localVars>
                  <variable name="eState">
                    <type>
                      <derived name="E_State" />
                    </type>
                    <initialValue>
                      <simpleValue value="E_State.IDLE" />
                    </initialValue>
                    <documentation>
                      <xhtml xmlns="http://www.w3.org/1999/xhtml"> Current machine state</xhtml>
                    </documentation>
                  </variable>
                  <variable name="rtSensor">
                    <type>
                      <derived name="R_TRIG" />
                    </type>
                    <documentation>
                      <xhtml xmlns="http://www.w3.org/1999/xhtml"> Rising edge detector for the sensor</xhtml>
                    </documentation>
                  </variable>
                  <variable name="bStartReq">
                    <type>
                      <BOOL />
                    </type>
                    <documentation>
                      <xhtml xmlns="http://www.w3.org/1999/xhtml"> Command requests, set by the methods and cleared at the end of each cycle</xhtml>
                    </documentation>
                  </variable>
                  <variable name="bStopReq">
                    <type>
                      <BOOL />
                    </type>
                  </variable>
                  <variable name="bResetReq">
                    <type>
                      <BOOL />
                    </type>
                  </variable>
                </localVars>
                <addData>
                  <data name="http://www.3s-software.com/plcopenxml/pouinheritance" handleUnknown="implementation">
                    <Inheritance>
                      <Implements>IConveyor</Implements>
                    </Inheritance>
                  </data>
                </addData>
              </interface>
              <body>
                <ST>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">// Detect rising edge of the sensor (one pulse per product)
rtSensor(CLK := bSensor);

// E-Stop has priority over everything, in every state
IF NOT bEStopNC THEN
    eState := E_State.ESTOP;
END_IF

CASE eState OF

    E_State.IDLE:
        bMotor := FALSE;
        // Start is ignored if a stop request arrives in the same cycle
        IF bStartReq AND NOT bStopReq THEN
            iCount := 0;
            eState := E_State.RUNNING;
        END_IF

    E_State.RUNNING:
        bMotor := TRUE;
        IF rtSensor.Q THEN
            iCount := iCount + 1;
        END_IF
        IF bStopReq THEN
            // Normal stop: back to idle
            eState := E_State.IDLE;
        ELSIF iCount &gt;= iTarget THEN
            // Batch finished
            eState := E_State.BATCH_DONE;
        END_IF

    E_State.BATCH_DONE:
        bMotor := FALSE;
        IF bResetReq THEN
            iCount := 0;
            eState := E_State.IDLE;
        END_IF

    E_State.ESTOP:
        bMotor := FALSE;
        // E-Stop must be released AND a reset request is required
        IF bEStopNC AND bResetReq THEN
            iCount := 0;
            eState := E_State.IDLE;
        END_IF

END_CASE

// Status outputs are driven directly from the current state
bBatchDone   := (eState = E_State.BATCH_DONE);
bEStopActive := (eState = E_State.ESTOP);

// Clear the requests: each method call is valid for one cycle only
bStartReq := FALSE;
bStopReq  := FALSE;
bResetReq := FALSE;
</xhtml>
                </ST>
              </body>
