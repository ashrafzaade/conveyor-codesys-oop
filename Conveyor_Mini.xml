          <data name="http://www.3s-software.com/plcopenxml/pou" handleUnknown="implementation">
            <pou name="PLC_PRG" pouType="program">
              <interface>
                <localVars>
                  <variable name="bStart">
                    <type>
                      <BOOL />
                    </type>
                    <documentation>
                      <xhtml xmlns="http://www.w3.org/1999/xhtml"> Start button (NO)</xhtml>
                    </documentation>
                  </variable>
                  <variable name="bStopNC">
                    <type>
                      <BOOL />
                    </type>
                    <initialValue>
                      <simpleValue value="TRUE" />
                    </initialValue>
                    <documentation>
                      <xhtml xmlns="http://www.w3.org/1999/xhtml"> Stop button (NC)</xhtml>
                    </documentation>
                  </variable>
                  <variable name="bEStopNC">
                    <type>
                      <BOOL />
                    </type>
                    <initialValue>
                      <simpleValue value="TRUE" />
                    </initialValue>
                    <documentation>
                      <xhtml xmlns="http://www.w3.org/1999/xhtml"> Emergency stop (NC)</xhtml>
                    </documentation>
                  </variable>
                  <variable name="bReset">
                    <type>
                      <BOOL />
                    </type>
                    <documentation>
                      <xhtml xmlns="http://www.w3.org/1999/xhtml"> Reset button (NO)</xhtml>
                    </documentation>
                  </variable>
                  <variable name="bSensor">
                    <type>
                      <BOOL />
                    </type>
                    <documentation>
                      <xhtml xmlns="http://www.w3.org/1999/xhtml"> Sensor of conveyor 1</xhtml>
                    </documentation>
                  </variable>
                  <variable name="bSensor2">
                    <type>
                      <BOOL />
                    </type>
                    <documentation>
                      <xhtml xmlns="http://www.w3.org/1999/xhtml"> Sensor of conveyor 2 (test via watch window)</xhtml>
                    </documentation>
                  </variable>
                  <variable name="bMotor">
                    <type>
                      <BOOL />
                    </type>
                    <documentation>
                      <xhtml xmlns="http://www.w3.org/1999/xhtml"> --- Outputs of conveyor 1 (bound to the visualization) ---</xhtml>
                    </documentation>
                  </variable>
                  <variable name="bBatchLamp">
                    <type>
                      <BOOL />
                    </type>
                  </variable>
                  <variable name="bEStopLamp">
                    <type>
                      <BOOL />
                    </type>
                  </variable>
                  <variable name="iCount">
                    <type>
                      <INT />
                    </type>
                  </variable>
                  <variable name="rtStart">
                    <type>
                      <derived name="R_TRIG" />
                    </type>
                    <documentation>
                      <xhtml xmlns="http://www.w3.org/1999/xhtml"> --- Edge detectors for the buttons ---</xhtml>
                    </documentation>
                  </variable>
                  <variable name="rtReset">
                    <type>
                      <derived name="R_TRIG" />
                    </type>
                  </variable>
                  <variable name="Conv1">
                    <type>
                      <derived name="FB_Conveyor" />
                    </type>
                    <documentation>
                      <xhtml xmlns="http://www.w3.org/1999/xhtml"> --- Two instances: one base type, one derived type ---</xhtml>
                    </documentation>
                  </variable>
                  <variable name="Conv2">
                    <type>
                      <derived name="FB_JamConveyor" />
                    </type>
                    <initialValue>
                      <structValue>
                        <value member="iTarget">
                          <simpleValue value="5" />
                        </value>
                      </structValue>
                    </initialValue>
                    <documentation>
                      <xhtml xmlns="http://www.w3.org/1999/xhtml"> different batch size</xhtml>
                    </documentation>
                  </variable>
                  <variable name="aConv">
                    <type>
                      <array>
                        <dimension lower="1" upper="2" />
                        <baseType>
                          <derived name="IConveyor" />
                        </baseType>
                      </array>
                    </type>
                    <documentation>
                      <xhtml xmlns="http://www.w3.org/1999/xhtml"> --- Interface references for polymorphic access ---</xhtml>
                    </documentation>
                  </variable>
                  <variable name="i">
                    <type>
                      <INT />
                    </type>
                  </variable>
                  <variable name="bMotor2">
                    <type>
                      <BOOL />
                    </type>
                    <documentation>
                      <xhtml xmlns="http://www.w3.org/1999/xhtml"> --- Mirror of conveyor 2 outputs, for easy monitoring ---</xhtml>
                    </documentation>
                  </variable>
                  <variable name="bJam2">
                    <type>
                      <BOOL />
                    </type>
                  </variable>
                </localVars>
              </interface>
              <body>
                <ST>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">// Edge detection for the buttons
rtStart(CLK := bStart);
rtReset(CLK := bReset);

// Bind interface references to the concrete instances
aConv[1] := Conv1;
aConv[2] := Conv2;

// Polymorphic commands: the loop does not know which type each element is
FOR i := 1 TO 2 DO
    IF rtStart.Q THEN
        aConv[i].Start();
    END_IF
    IF NOT bStopNC THEN
        aConv[i].Stop();
    END_IF
    IF rtReset.Q THEN
        aConv[i].Reset();
    END_IF
END_FOR

// Cyclic execution of each instance
Conv1(bSensor := bSensor,  bEStopNC := bEStopNC);
Conv2(bSensor := bSensor2, bEStopNC := bEStopNC, tJamTimeout := T#5S);

// Map conveyor 1 outputs to the variables used by the visualization
bMotor     := Conv1.bMotor;
bBatchLamp := Conv1.bBatchDone;
bEStopLamp := Conv1.bEStopActive;
iCount     := Conv1.iCount;

// Mirror conveyor 2 outputs
bMotor2 := Conv2.bMotor;
bJam2   := Conv2.bJam;
</xhtml>
                </ST>
              </body>
              <addData>
