                <data name="http://www.3s-software.com/plcopenxml/method" handleUnknown="implementation">
                  <Method name="Start" ObjectId="9cb67cdf-1143-47e7-a117-808949aa29dd">
                    <interface />
                    <body>
                      <ST>
                        <xhtml xmlns="http://www.w3.org/1999/xhtml">// Request a start (valid for one cycle)
   bStartReq := TRUE;
   </xhtml>
                      </ST>
                    </body>
                    <addData />
                  </Method>
                </data>
                <data name="http://www.3s-software.com/plcopenxml/method" handleUnknown="implementation">
                  <Method name="Stop" ObjectId="c377ca6e-45d8-480d-aa95-35a4fa825b55">
                    <interface />
                    <body>
                      <ST>
                        <xhtml xmlns="http://www.w3.org/1999/xhtml">// Request a normal stop (valid for one cycle)
bStopReq := TRUE;
</xhtml>
                      </ST>
                    </body>
                    <addData />
                  </Method>
                </data>
                <data name="http://www.3s-software.com/plcopenxml/method" handleUnknown="implementation">
                  <Method name="Reset" ObjectId="31c90ad5-86cb-4821-a24c-4e631786f22f">
                    <interface />
                    <body>
                      <ST>
                        <xhtml xmlns="http://www.w3.org/1999/xhtml">// Request a reset after batch complete or emergency stop (valid for one cycle)
bResetReq := TRUE;
</xhtml>
                      </ST>
                    </body>
                    <addData />
                  </Method>
                </data>
                <data name="http://www.3s-software.com/plcopenxml/objectid" handleUnknown="discard">
                  <ObjectId>0ab37e3c-12ab-495a-9799-5201a7cff6dc</ObjectId>
                </data>
              </addData>
            </pou>
          </data>
          <data name="http://www.3s-software.com/plcopenxml/pou" handleUnknown="implementation">
            <pou name="FB_JamConveyor" pouType="functionBlock">
              <interface>
                <inputVars>
                  <variable name="tJamTimeout">
                    <type>
                      <TIME />
                    </type>
                    <initialValue>
                      <simpleValue value="TIME#5s0ms" />
                    </initialValue>
                    <documentation>
                      <xhtml xmlns="http://www.w3.org/1999/xhtml"> Max time without a product while running</xhtml>
                    </documentation>
                  </variable>
                </inputVars>
                <outputVars>
                  <variable name="bJam">
                    <type>
                      <BOOL />
                    </type>
                    <documentation>
                      <xhtml xmlns="http://www.w3.org/1999/xhtml"> TRUE when a jam has been detected</xhtml>
                    </documentation>
                  </variable>
                </outputVars>
                <localVars>
                  <variable name="tonJam">
                    <type>
                      <derived name="TON" />
                    </type>
                    <documentation>
                      <xhtml xmlns="http://www.w3.org/1999/xhtml"> Timer for jam detection</xhtml>
                    </documentation>
                  </variable>
                </localVars>
                <addData>
                  <data name="http://www.3s-software.com/plcopenxml/pouinheritance" handleUnknown="implementation">
                    <Inheritance>
                      <Extends>FB_Conveyor</Extends>
                    </Inheritance>
                  </data>
                </addData>
              </interface>
              <body>
                <ST>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">// Run the base class logic first (not called automatically in CODESYS)
SUPER^();

// Jam detection: motor running but no product detected for tJamTimeout.
// The timer is reset by every product (rising edge of the sensor).
tonJam(IN := (eState = E_State.RUNNING) AND NOT rtSensor.Q, PT := tJamTimeout);

IF tonJam.Q THEN
    bJam := TRUE;
    eState := E_State.IDLE;   // Stop the conveyor
END_IF
</xhtml>
                </ST>
              </body>
              <addData>
                <data name="http://www.3s-software.com/plcopenxml/method" handleUnknown="implementation">
                  <Method name="Start" ObjectId="b414f030-e14f-44e3-a33a-25a8a31db3e9">
                    <interface />
                    <body>
                      <ST>
                        <xhtml xmlns="http://www.w3.org/1999/xhtml">// Override: ignore start requests while a jam is active
IF NOT bJam THEN
    SUPER^.Start();   // Call the base class method
END_IF</xhtml>
                      </ST>
                    </body>
                    <addData />
                  </Method>
                </data>
                <data name="http://www.3s-software.com/plcopenxml/method" handleUnknown="implementation">
                  <Method name="Reset" ObjectId="9965ee90-687e-42af-95f7-6507f4c25ee4">
                    <interface />
                    <body>
                      <ST>
                        <xhtml xmlns="http://www.w3.org/1999/xhtml">// Override: also clear the jam flag, then do the normal reset
bJam := FALSE;
SUPER^.Reset();
</xhtml>
                      </ST>
                    </body>
                    <addData />
                  </Method>
                </data>
                <data name="http://www.3s-software.com/plcopenxml/objectid" handleUnknown="discard">
                  <ObjectId>6b6f90fb-5a6e-4c81-aa64-6f99476e55dd</ObjectId>
                </data>
              </addData>
            </pou>
          </data>
